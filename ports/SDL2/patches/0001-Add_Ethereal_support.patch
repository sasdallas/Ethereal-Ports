+
+#include <kernel/gfx/video.h>
+#include <sys/ioctl.h>
+#include <sys/fcntl.h>
+#include <unistd.h>
+#include <string.h>
+#include <errno.h>
+#include <stdio.h>
+
+bool ETHEREAL_InitModes(_THIS) {
+    int fb = open("/device/fb0", O_RDONLY);
+    if (fb < 0) {
+        return SDL_SetError("Failed to open /device/fb0: %s\n", strerror(errno));
+    }
+
+    video_info_t info;
+    if (ioctl(fb, IO_VIDEO_GET_INFO, &info) < 0) {
+        return SDL_SetError("IO_VIDEO_GET_INFO failed: %s\n", strerror(errno));
+    }
+
+    close(fb);
+
+    SDL_DisplayMode mode = {
+        .format = SDL_PIXELFORMAT_XRGB8888,
+        .w = (int)info.screen_width,
+        .h = (int)info.screen_height,
+        .refresh_rate = 60.0f,
+        .driverdata = NULL
+    };
+
+    SDL_AddBasicVideoDisplay(&mode);
+    return true;
+}
+
+
+void ETHEREAL_QuitModes(_THIS) {
+    // stub
+}
+
+#endif
