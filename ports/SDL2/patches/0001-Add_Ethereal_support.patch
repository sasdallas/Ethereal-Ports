+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_ETHEREAL
+
+#include "SDL_etherealwindow.h"
+#include "SDL_etherealkeyboard.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_windowevents_c.h"
+#include <errno.h>
+
+static uint32_t ETHEREAL_ConvertToSDLMouse(uint32_t buttons) {
+    if (buttons & CELESTIAL_MOUSE_BUTTON_LEFT) return SDL_BUTTON_LEFT;
+    if (buttons & CELESTIAL_MOUSE_BUTTON_RIGHT) return SDL_BUTTON_RIGHT;
+    if (buttons & CELESTIAL_MOUSE_BUTTON_MIDDLE) return SDL_BUTTON_MIDDLE;
+    return 0;
+}
+
+void ETHEREAL_PositionChangeEvent(window_t *win, uint32_t event_type, void *event) {
+    celestial_event_position_change_t *ev = event;
+    SDL_WindowData *wdata = win->d;
+
+    SDL_SendWindowEvent(wdata->sdlwindow, SDL_WINDOWEVENT_MOVED, ev->x, ev->y);
+}
+
+void ETHEREAL_MouseMotionEvent(window_t *win, uint32_t event_type, void *event) {
+    celestial_event_mouse_motion_t *ev = event;
+    SDL_WindowData *wdata = win->d;
+
+    SDL_SendMouseMotion(wdata->sdlwindow, 0, SDL_FALSE, ev->x, ev->y);
+}
+
+void ETHEREAL_MouseDownEvent(window_t *win, uint32_t event_type, void *event) {
+    celestial_event_mouse_button_down_t *ev = event;
+    SDL_WindowData *wdata = win->d;
+
+    SDL_SendMouseButton(wdata->sdlwindow, 0, SDL_PRESSED, ETHEREAL_ConvertToSDLMouse(ev->held));
+}
+
+void ETHEREAL_MouseUpEvent(window_t *win, uint32_t event_type, void *event) {
+    celestial_event_mouse_button_up_t *ev = event;
+    SDL_WindowData *wdata = win->d;
+
+    SDL_SendMouseButton(wdata->sdlwindow, 0, SDL_RELEASED, ETHEREAL_ConvertToSDLMouse(ev->released));
+}
+
+void ETHEREAL_MouseMotionRelEvent(window_t *win, uint32_t event_type, void *event) {
+    celestial_event_mouse_motion_rel_t *ev = event;
+    SDL_WindowData *wdata = win->d;
+
+    SDL_SendMouseMotion(wdata->sdlwindow, 0, SDL_TRUE, ev->x, ev->y);
+}
+
+void ETHEREAL_KeyEvent(window_t *win, uint32_t event_type, void *event) {
+    SDL_WindowData *wdata = win->d;
+    ETHEREAL_KeyboardProcess(wdata->sdlwindow, event);
+}
+
+void ETHEREAL_ResizeHandler(window_t *win, uint32_t event_type, void *event) {
+    SDL_WindowData *wdata = win->d;
+    celestial_event_resize_t *resize = event;
+    SDL_SendWindowEvent(wdata->sdlwindow, SDL_WINDOWEVENT_RESIZED, resize->new_width, resize->new_height);
+}
+
+void ETHEREAL_RegisterEventHandlers(SDL_WindowData *data) {
+    celestial_setHandler(data->window, CELESTIAL_EVENT_POSITION_CHANGE, ETHEREAL_PositionChangeEvent);
+
+    celestial_setHandler(data->window, CELESTIAL_EVENT_MOUSE_MOTION, ETHEREAL_MouseMotionEvent);
+    celestial_setHandler(data->window, CELESTIAL_EVENT_MOUSE_BUTTON_DOWN, ETHEREAL_MouseDownEvent);
+    celestial_setHandler(data->window, CELESTIAL_EVENT_MOUSE_BUTTON_UP, ETHEREAL_MouseUpEvent);
+    celestial_setHandler(data->window, CELESTIAL_EVENT_MOUSE_MOTION_REL, ETHEREAL_MouseMotionRelEvent);
+
+    celestial_setHandler(data->window, CELESTIAL_EVENT_KEY_EVENT, ETHEREAL_KeyEvent);
+    celestial_setHandler(data->window, CELESTIAL_EVENT_RESIZE, ETHEREAL_ResizeHandler);
+}
+
+int ETHEREAL_CreateSDLWindow(_THIS, SDL_Window *window) {
+    TRACE();
+    SDL_WindowData *data = SDL_calloc(1, sizeof(SDL_WindowData));
+    data->sdlwindow = window;
+    
+    // Prepare to create window
+    wid_t wid;
+    if (window->flags & SDL_WINDOW_BORDERLESS) {
+        wid = celestial_createWindowUndecorated(0, (size_t)window->w, (size_t)window->h);
+    } else {
+        wid = celestial_createWindow(0, (size_t)window->w, (size_t)window->h);
+    }
+
+    if (wid < 0) {
+        return SDL_SetError("celestial_createWindow failed with error %s", strerror(errno));
+    }
+
+    window_t *win = celestial_getWindow(wid);
+    if (!win) {
+        return SDL_SetError("celestial_getWindow failed with error %s", strerror(errno));
+    }
+
+    if (window->flags & SDL_WINDOW_RESIZABLE) {
+        celestial_setResizeEnabled(win, true);
+    }
+
+    data->window = win;
+    data->surface = NULL;
+    
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+
+    win->d = data;
+    window->driverdata = data;
+
+    ETHEREAL_RegisterEventHandlers(data);
+
+    return 0;
+}
+
+void ETHEREAL_DestroyWindow(_THIS, SDL_Window *window) {
+    SDL_WindowData *wdata = window->driverdata;
+
+    celestial_closeWindow(wdata->window);
+    SDL_free(wdata);
+}
+
+
+void ETHEREAL_SetWindowTitle(_THIS, SDL_Window *window) {
+    SDL_WindowData *wdata = window->driverdata;
+    celestial_setTitle(wdata->window, window->title);
+}
+
+void ETHEREAL_SetWindowResizable(_THIS, SDL_Window *window, SDL_bool resizable) {
+    SDL_WindowData *wdata = window->driverdata;
+    celestial_setResizeEnabled(wdata->window, resizable);
+}
+
+void ETHEREAL_SetWindowPosition(_THIS, SDL_Window *window) {
+    SDL_WindowData *wdata = window->driverdata;
+    celestial_setWindowPosition(wdata->window, window->x, window->y);
+}
+
+void ETHEREAL_SetWindowSize(_THIS, SDL_Window *window) {
+    SDL_WindowData *wdata = window->driverdata;
+    celestial_resizeWindow(wdata->window, window->w, window->h);
+}
+
+void ETHEREAL_SetWindowMaximumSize(_THIS, SDL_Window *window) {
+    SDL_WindowData *wdata = window->driverdata;
+    celestial_setResizeBounds(wdata->window, (size_t)window->min_w, (size_t)window->min_h, (size_t)window->max_w, (size_t)window->max_h);
+}
+
+void ETHEREAL_SetWindowMinimumSize(_THIS, SDL_Window *window) {
+    SDL_WindowData *wdata = window->driverdata;
+    celestial_setResizeBounds(wdata->window, (size_t)window->min_w, (size_t)window->min_h, (size_t)window->max_w, (size_t)window->max_h);
+}
+
+#endif
