+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_ETHEREAL
+
+#include "SDL_etherealframebuffer.h"
+#include "SDL_etherealwindow.h"
+#include <ethereal/celestial.h>
+#include <graphics/gfx.h>
+
+#if (defined(__i386__) || defined(__x86_64__)) && !defined(__NO_SSE)
+#include <emmintrin.h>
+__m128i alpha_mask;
+
+__attribute__((constructor)) void ETHEREAL_InitSSEMask() {
+    alpha_mask = _mm_set1_epi32((int)0xFF000000);
+}
+#endif 
+
+int ETHEREAL_CreateWindowFramebuffer(_THIS, SDL_Window *window, Uint32 *format, void **pixels, int *pitch) {
+    SDL_WindowData *wdata = window->driverdata;
+    gfx_context_t *ctx = celestial_getGraphicsContext(wdata->window);
+
+    *format = SDL_PIXELFORMAT_XRGB8888;
+    *pixels = ctx->backbuffer;
+    *pitch = (int)ctx->pitch;
+
+    gfx_clear(ctx, GFX_RGB(0,0,0));
+    
+    return 0;
+}
+
+void ETHEREAL_DestroyWindowFramebuffer(_THIS, SDL_Window *window) {
+    // TODO
+}
+
+int ETHEREAL_UpdateWindowFramebuffer(_THIS, SDL_Window *window, const SDL_Rect *rects, int numrects) {
+    SDL_WindowData *wdata = window->driverdata;
+    gfx_context_t *ctx = celestial_getGraphicsContext(wdata->window);
+
+    // TODO: use the rectangles
+
+    // !!! THIS IS A SEVERE HACK. Forces the background to be fully solid since no matter what I could not get SDL to cooperate on this.
+#if (defined(__i386__) || defined(__x86_64__)) && !defined(__NO_SSE)
+    uint8_t *row = (uint8_t*)ctx->backbuffer;
+
+    int vec_width = ctx->width / 4;
+    int rem = ctx->width % 4;
+
+    for (unsigned y = 0; y < ctx->height; y++) {
+        uint32_t *pixels = (uint32_t*)row;
+
+        for (int x = 0; x < vec_width; x++) {
+            __m128i data = _mm_loadu_si128((__m128i*)pixels);
+            data = _mm_or_si128(data, alpha_mask);
+            _mm_storeu_si128((__m128i*)pixels, data);
+            pixels += 4;
+        }
+
+        for (int x = 0; x < rem; x++) {
+            *pixels++ |= 0xFF000000;
+        }
+
+        row += ctx->pitch;
+    }
+#else
+    uint32_t *buffer = ctx->backbuffer;
+    for (unsigned i = 0; i < ctx->height; i++) {
+        for (unsigned j = 0; j < ctx->width; j++) {
+            buffer[j] |= 0xFF000000;
+        }
+
+        buffer = ((uint8_t*)buffer + ctx->pitch);
+    }
+#endif
+
+    gfx_render(ctx);
+    celestial_flip(wdata->window);
+    return 0;
+}
+
+#endif
