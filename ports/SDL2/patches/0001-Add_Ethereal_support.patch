+#include "../../SDL_internal.h"
+
+#if defined(SDL_AUDIO_DRIVER_ETHEREAL) || defined(__INTELLISENSE__)
+
+
+#include "SDL_timer.h"
+#include "SDL_audio.h"
+#include "../SDL_audio_c.h"
+#include "SDL_etherealaudio.h"
+
+#include <sys/ioctl.h>
+#include <sys/fcntl.h>
+#include <unistd.h>
+#include <string.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <stdio.h>
+
+#if 0
+#define TRACE() fprintf(stderr, "AUDIO: Enter %s\n", __FUNCTION__)
+#else
+#define TRACE()
+#endif
+
+#if 0
+
+static int ETHEREAL_ConfigureDevice(struct SDL_PrivateAudioData *private) {
+    TRACE();
+    audio_stream_config_t config = {
+        .format = AUDIO_FORMAT_S16_LE,
+        .channels = 2,
+        .periods = 4,
+        .period_size = 2048,
+        .sample_rate = 44100,
+        .start_thres = 2,
+    };
+
+    if (ioctl(private->device_fd, IO_AUDIO_SET_CONFIG, &config) < 0) {
+        return SDL_SetError("Failed to IO_AUDIO_SET_CONFIG: %s", strerror(errno));
+    }
+
+    private->ready = true;
+    return 0;
+}
+
+static int ETHEREAL_OpenDevice(_THIS,  const char *devname) {
+    TRACE();
+    this->hidden = SDL_malloc(sizeof(struct SDL_PrivateAudioData));
+
+    struct SDL_PrivateAudioData *private = this->hidden;
+
+    char *audio_device = SDL_getenv("AUDIODEV");
+    if (!audio_device) audio_device = "/device/audio0s0";
+
+    private->device_fd = open(audio_device, O_RDONLY);
+    if (private->device_fd < 0) {
+        return SDL_SetError("Failed to create audio device %s: %s", audio_device, strerror(errno));
+    }
+
+    private->mixbuf = SDL_malloc(16384);
+    private->ready = false;
+
+    this->spec.freq = 44100;
+    this->spec.format = AUDIO_S16SYS;
+    this->spec.channels = 2;
+    this->spec.samples = 2048;
+    SDL_CalculateAudioSpec(&this->spec);
+
+    
+    return 0;
+}
+
+static void ETHEREAL_CloseDevice(_THIS) {
+    TRACE();
+    struct SDL_PrivateAudioData *private = this->hidden;
+    audio_stream_request_t req = AUDIO_STREAM_DRAIN;
+    ioctl(private->device_fd, IO_AUDIO_REQUEST, &req);
+}
+
+static void ETHEREAL_PlayDevice(_THIS) {
+    TRACE();
+    struct SDL_PrivateAudioData *private = this->hidden;
+    const bool enabled = SDL_AtomicGet(&this->enabled) && !SDL_AtomicGet(&this->paused);
+
+    if (!enabled) {
+        audio_stream_request_t req = AUDIO_STREAM_STOP;
+        ioctl(private->device_fd, IO_AUDIO_REQUEST, &req);
+        private->ready = false;
+        return 0;
+    }
+
+    if (private->ready == false) {
+        int r = ETHEREAL_ConfigureDevice(private);
+        if (r != 0) {
+            fprintf(stderr, "Failed to configure device: %s\n", SDL_GetError());
+            return;
+        }
+        
+        audio_stream_request_t req = AUDIO_STREAM_PLAY;
+        ioctl(private->device_fd, IO_AUDIO_REQUEST, &req);
+    }
+
+    size_t samples = this->spec.size;
+    write(private->device_fd, (void*)private->mixbuf, samples);
+}
+
+static Uint8* ETHEREAL_GetDeviceBuf(_THIS) {
+    TRACE();
+    struct SDL_PrivateAudioData *hidden = this->hidden;
+    return hidden->mixbuf;
+}
+
+#else
+
+static int ETHEREAL_OpenDevice(_THIS,  const char *devname) {
+    TRACE();
+    this->hidden = SDL_malloc(sizeof(struct SDL_PrivateAudioData));
+
+    struct SDL_PrivateAudioData *private = this->hidden;
+
+    if (symphony_connect() != 0) {
+        return SDL_SetError("symphony_connect failed: %s", strerror(errno));
+    }
+
+    symphony_info_t info;
+    if (symphony_getInfo(&info) != 0) {
+        return SDL_SetError("symphony_getInfo failed: %s", strerror(errno));
+    }
+
+    if (info.num_devices == 0) {
+        return SDL_SetError("No devices available");
+    }
+
+    unsigned short target_stream = 0;
+    char *streamenv = SDL_getenv("SYMPHONY_DEFAULT_STREAM");
+    if (streamenv) {
+        target_stream = strtol(streamenv, NULL, 16);
+    }
+
+    fprintf(stderr, "AUDIO: opening target stream 0x%x\n", target_stream);
+
+    symphony_stream_info_t stream_info;
+    if (symphony_getStream(target_stream, &stream_info) != 0) {
+        return SDL_SetError("symphony_getStream failed: %s", strerror(errno));
+    }
+
+    this->spec.freq = stream_info.config.sample_rate;
+    this->spec.channels = stream_info.config.channels;
+    this->spec.samples = 2048;
+
+    if (stream_info.config.format == AUDIO_FORMAT_S16_LE) {
+        this->spec.format = AUDIO_S16SYS;
+    } else if (stream_info.config.format == AUDIO_FORMAT_S24_LE) {
+        return SDL_SetError("AUDIO_FORMAT_S24LE not supported");
+    } else if (stream_info.config.format == AUDIO_FORMAT_S32_LE) {
+        this->spec.format = AUDIO_S32SYS;
+    } else if (stream_info.config.format == AUDIO_FORMAT_F32_LE) {
+        this->spec.format = AUDIO_F32SYS;
+    } else {
+        return SDL_SetError("Unknown audio format");
+    }
+
+    SDL_CalculateAudioSpec(&this->spec);
+
+    fprintf(stderr, "create: %d format %d chan %d sample rate\n", stream_info.config.format, stream_info.config.channels, stream_info.config.sample_rate);
+    private->bufid = symphony_addBuffer(target_stream, stream_info.config.format, stream_info.config.sample_rate, stream_info.config.channels, this->spec.samples * this->spec.channels);
+    if (private->bufid < 0) {
+        return SDL_SetError("symphony_addBuffer failed: %s", strerror(errno));
+    }
+
+    private->mixbuf = SDL_malloc(this->spec.size);
+    private->ready = false;
+
+    return 0;
+}
+
+static void ETHEREAL_CloseDevice(_THIS) {
+    TRACE();
+    struct SDL_PrivateAudioData *private = this->hidden;
+    symphony_drain(private->bufid);
+}
+
+static void ETHEREAL_PlayDevice(_THIS) {
+    TRACE();
+    struct SDL_PrivateAudioData *private = this->hidden;
+    const bool enabled = SDL_AtomicGet(&this->enabled) && !SDL_AtomicGet(&this->paused);
+
+    if (!enabled) {
+        symphony_stop(private->bufid);
+        return;
+    }
+
+    symphony_start(private->bufid);
+    symphony_write(private->bufid, private->mixbuf, this->spec.samples * this->spec.channels);
+}
+
+static Uint8* ETHEREAL_GetDeviceBuf(_THIS) {
+    TRACE();
+    struct SDL_PrivateAudioData *hidden = this->hidden;
+    return hidden->mixbuf;
+}
+
+#endif
+
+static SDL_bool ETHEREAL_Init(SDL_AudioDriverImpl *impl) {
+    impl->OpenDevice = ETHEREAL_OpenDevice;
+    impl->CloseDevice = ETHEREAL_CloseDevice;
+    impl->PlayDevice = ETHEREAL_PlayDevice;
+    impl->GetDeviceBuf = ETHEREAL_GetDeviceBuf;
+
+    impl->ProvidesOwnCallbackThread = SDL_FALSE;
+    impl->HasCaptureSupport = SDL_FALSE;
+    impl->OnlyHasDefaultOutputDevice = SDL_TRUE;
+    impl->SupportsNonPow2Samples = SDL_TRUE;
+
+    return SDL_TRUE;
+}
+
+AudioBootStrap ETHEREALAUDIO_bootstrap = {
+    "ethereal", "Ethereal Audio Backend", ETHEREAL_Init, SDL_FALSE
+};
+
+#endif
