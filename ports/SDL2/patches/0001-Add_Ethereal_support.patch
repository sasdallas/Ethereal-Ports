+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_ETHEREAL
+#ifdef SDL_VIDEO_OPENGL
+
+#include "SDL_etherealopengl.h"
+#include "SDL_etherealwindow.h"
+#include <dlfcn.h>
+
+#if (defined(__i386__) || defined(__x86_64__)) && !defined(__NO_SSE)
+#include <emmintrin.h>
+static __m128i alpha_mask;
+
+__attribute__((constructor)) void ETHEREAL_InitGLSSEMask() {
+    alpha_mask = _mm_set1_epi32((int)0xFF000000);
+}
+#endif 
+
+int ETHEREAL_GL_LoadLibrary(_THIS, const char *path) {
+    if (_this->gl_config.driver_loaded) {
+        return SDL_SetError("OpenGL library is already loaded");
+    }
+
+    _this->gl_config.driver_loaded = 1;
+    return 0;
+}
+
+void ETHEREAL_GL_UnloadLibrary(_THIS) {
+    _this->gl_config.driver_loaded = 0;
+}
+
+SDL_GLContext ETHEREAL_GL_CreateContext(_THIS, SDL_Window *window) {
+    SDL_GLData *data = SDL_calloc(1, sizeof(SDL_GLData));
+    data->window = window;
+
+    int depth_bits;
+    if (_this->gl_config.depth_size <= 0) {
+        depth_bits = 0;
+    } else if (_this->gl_config.depth_size <= 16) {
+        depth_bits = 16;
+    } else if (_this->gl_config.depth_size <= 24) {
+        depth_bits = 24;
+    } else {
+        depth_bits = 32;
+    }
+
+    int stencil_bits = (_this->gl_config.stencil_size <= 0) ? 0 : 8;
+    int accum_bits = (_this->gl_config.accum_alpha_size+_this->gl_config.accum_red_size+_this->gl_config.accum_green_size+_this->gl_config.accum_blue_size);
+    accum_bits = (accum_bits <= 0) ? 0 : 16;
+    
+    int profile;
+    if (_this->gl_config.profile_mask == SDL_GL_CONTEXT_PROFILE_CORE) {
+        profile = OSMESA_CORE_PROFILE;
+    } else if (_this->gl_config.profile_mask == 0 || _this->gl_config.profile_mask == SDL_GL_CONTEXT_PROFILE_COMPATIBILITY) {
+        profile = OSMESA_COMPAT_PROFILE;
+    } else {
+        profile = 0;
+    }
+
+    // taken from https://github.com/Bananymous/banan-os/blob/main/ports/SDL3/patches/0001-add-banan_os-support.patch
+    int attributes[] = {
+        OSMESA_FORMAT, OSMESA_BGRA,
+        OSMESA_DEPTH_BITS, depth_bits,
+        OSMESA_STENCIL_BITS, stencil_bits,
+        OSMESA_ACCUM_BITS, accum_bits,
+        OSMESA_PROFILE, profile,
+        OSMESA_CONTEXT_MAJOR_VERSION, _this->gl_config.major_version,
+        OSMESA_CONTEXT_MINOR_VERSION, _this->gl_config.minor_version,
+        0
+    };
+
+    OSMesaContext sharelist = NULL;
+    if (_this->gl_config.share_with_current_context) {
+        SDL_GLData *current = (SDL_GLData*)SDL_GL_GetCurrentContext();
+        if (current != NULL) {
+            sharelist = current->context;
+        }
+    }
+
+    OSMesaContext context = OSMesaCreateContextAttribs(attributes, sharelist);
+    if (!context) {
+        SDL_free(data);
+        SDL_SetError("OSMesaCreateContext call failed");
+        return NULL;
+    }
+    
+    data->context = context;
+
+    if (ETHEREAL_GL_MakeCurrent(_this, window, (SDL_GLContext)data)) {
+        SDL_free(data);
+        OSMesaDestroyContext(context);
+        return NULL;
+    }
+
+    return (SDL_GLContext)data;
+}
+
+void ETHEREAL_GL_DeleteContext(_THIS, SDL_GLContext context) {
+    SDL_GLData *data = (SDL_GLData*)context;
+    SDL_WindowData *wdata = data->window->driverdata;
+
+    if (wdata->gl_context == context) {
+        // need to set to NULL
+        if (ETHEREAL_GL_MakeCurrent(_this, data->window, NULL)) {
+            SDL_LogError(SDL_LOG_CATEGORY_VIDEO, "ETHEREAL_GL_MakeCurrent failed to switch context to NULL");
+            return;
+        }
+    }
+
+    OSMesaDestroyContext(data->context);
+    SDL_free(data);
+}
+
+int ETHEREAL_GL_SwapWindow(_THIS, SDL_Window *window) {
+    static void (*glFinish)() = NULL;
+    if (glFinish == NULL) {
+        glFinish = OSMesaGetProcAddress("glFinish");
+        if (glFinish == NULL) {
+            return SDL_SetError("could not locate glFinish");
+        }
+    }
+    
+    glFinish();
+    
+    SDL_WindowData *wdata = window->driverdata;
+    
+    gfx_context_t *ctx = celestial_getGraphicsContext(wdata->window);
+#if (defined(__i386__) || defined(__x86_64__)) && !defined(__NO_SSE)
+    uint8_t *row = (uint8_t*)ctx->backbuffer;
+
+    int vec_width = ctx->width / 4;
+    int rem = ctx->width % 4;
+
+    for (unsigned y = 0; y < ctx->height; y++) {
+        uint32_t *pixels = (uint32_t*)row;
+
+        for (int x = 0; x < vec_width; x++) {
+            __m128i data = _mm_loadu_si128((__m128i*)pixels);
+            data = _mm_or_si128(data, alpha_mask);
+            _mm_storeu_si128((__m128i*)pixels, data);
+            pixels += 4;
+        }
+
+        for (int x = 0; x < rem; x++) {
+            *pixels++ |= 0xFF000000;
+        }
+
+        row += ctx->pitch;
+    }
+#else
+    uint32_t *buffer = ctx->backbuffer;
+    for (unsigned i = 0; i < ctx->height; i++) {
+        for (unsigned j = 0; j < ctx->width; j++) {
+            buffer[j] |= 0xFF000000;
+        }
+
+        buffer = ((uint8_t*)buffer + ctx->pitch);
+    }
+#endif
+
+    gfx_render(ctx);
+    celestial_flip(wdata->window);
+
+    return 0;
+}
+
+int ETHEREAL_GL_MakeCurrent(_THIS, SDL_Window *window, SDL_GLContext context) {
+    if (context == NULL) {
+        // called on ETHEREAL_GL_DeleteContext
+        if (!OSMesaMakeCurrent(NULL, NULL, GL_UNSIGNED_BYTE, 0, 0)) {
+            return SDL_SetError("OSMesaMakeCurrent failed while unsetting context");
+        }
+
+        if (window == NULL) {
+            window = SDL_GL_GetCurrentWindow();
+        }
+
+        if (window) {
+            SDL_WindowData *wdata = window->driverdata;
+            wdata->gl_context = NULL;
+        }
+
+        return 0;
+    }
+
+    SDL_WindowData *wdata = window->driverdata;
+    SDL_GLData *data = context;
+
+    gfx_context_t *ctx = celestial_getGraphicsContext(wdata->window);
+
+    if (!OSMesaMakeCurrent(data->context, ctx->backbuffer, GL_UNSIGNED_BYTE, GFX_WIDTH(ctx), GFX_HEIGHT(ctx))) {
+        return SDL_SetError("OSMesaMakeCurrent encountered an error");
+    }
+
+    OSMesaPixelStore(OSMESA_Y_UP, 0);
+    OSMesaPixelStore(OSMESA_ROW_LENGTH, ctx->pitch / 4);
+
+    wdata->gl_context = context;
+    return 0;
+}
+
+void *ETHEREAL_GL_GetProcAddress(_THIS, const char *proc) {
+    void *addr = (void*)OSMesaGetProcAddress(proc);
+    return addr;
+}
+
+#endif
+#endif
