+SDL_Cursor *ETHEREAL_CreateSystemCursor(SDL_SystemCursor id) {
+    SDL_Cursor *cur = SDL_calloc(1, sizeof(SDL_Cursor));
+    return cur;
+}
+
+void ETHEREAL_FreeCursor(SDL_Cursor *cursor) {
+    SDL_free(cursor);
+}
+
+int ETHEREAL_ShowCursor(SDL_Cursor *cursor) {
+    // TODO
+    return 0;
+}
+
+int ETHEREAL_SetRelativeMouseMode(SDL_bool enabled) {
+    SDL_Window *window = SDL_GetMouseFocus();
+    if (!window) {
+        return 0;
+    }
+
+    SDL_WindowData *window_data = (SDL_WindowData*)window->driverdata;
+    window_t *c_window = window_data->window;
+
+    int r = celestial_setMouseCapture(c_window, enabled);
+    if (r != 0) {
+        return SDL_SetError("celestial_setMouseCapture failed with error: %s", strerror(errno));
+    }
+
+    return 0;
+}
+
+void ETHEREAL_MouseInit(_THIS) {
+    SDL_Mouse *mouse = SDL_GetMouse();
+
+    mouse->CreateSystemCursor = ETHEREAL_CreateSystemCursor;
+    mouse->FreeCursor = ETHEREAL_FreeCursor;
+    mouse->ShowCursor = ETHEREAL_ShowCursor;
+    mouse->SetRelativeMouseMode = ETHEREAL_SetRelativeMouseMode;
+}
