+    SDL_free(_this);
+}
+
+SDL_VideoDevice *ETHEREAL_CreateDevice() {
+    TRACE();
+    SDL_VideoDevice *device = (SDL_VideoDevice*)SDL_calloc(1, sizeof(SDL_VideoDevice));
+
+    device->VideoInit = ETHEREAL_VideoInit;
+    device->VideoQuit = ETHEREAL_VideoQuit;
+    device->free = ETHEREAL_Free;
+    
+    device->CreateSDLWindow = ETHEREAL_CreateSDLWindow;
+    device->DestroyWindow = ETHEREAL_DestroyWindow;
+    device->SetWindowTitle = ETHEREAL_SetWindowTitle;
+    device->SetWindowResizable = ETHEREAL_SetWindowResizable;
+    device->SetWindowPosition = ETHEREAL_SetWindowPosition;
+    device->SetWindowSize = ETHEREAL_SetWindowSize;
+    device->SetWindowMaximumSize = ETHEREAL_SetWindowMaximumSize;
+    device->SetWindowMinimumSize = ETHEREAL_SetWindowMinimumSize;
+
+    device->CreateWindowFramebuffer = ETHEREAL_CreateWindowFramebuffer;
+    device->DestroyWindowFramebuffer = ETHEREAL_DestroyWindowFramebuffer;
+    device->UpdateWindowFramebuffer = ETHEREAL_UpdateWindowFramebuffer;
+
+    device->PumpEvents = ETHEREAL_PumpEvents;
+    device->WaitEventTimeout = ETHEREAL_WaitEventTimeout;
+
+#ifdef SDL_VIDEO_OPENGL
+    device->GL_LoadLibrary = ETHEREAL_GL_LoadLibrary;
+    device->GL_UnloadLibrary = ETHEREAL_GL_UnloadLibrary;
+    device->GL_GetProcAddress = ETHEREAL_GL_GetProcAddress;
+    device->GL_CreateContext = ETHEREAL_GL_CreateContext;
+    device->GL_DeleteContext = ETHEREAL_GL_DeleteContext;
+    device->GL_SwapWindow = ETHEREAL_GL_SwapWindow;
+    device->GL_MakeCurrent = ETHEREAL_GL_MakeCurrent;
+#endif
+
+    return device;
+}
+
+int ETHEREAL_ShowMessageBox(const SDL_MessageBoxData *messageboxdata, int *buttonid) {
+    // TODO
