diff -Naur old_extract/libgpg-error-1.61/po/remove-potcdate.sin~ new_workspace/libgpg-error-1.61/po/remove-potcdate.sin~
--- a/po/remove-potcdate.sin~	1969-12-31 18:00:00.000000000 -0600
+++ b/po/remove-potcdate.sin~	2022-01-25 11:56:13.000000000 -0600
@@ -0,0 +1,25 @@
+# Sed script that removes the POT-Creation-Date line in the header entry
+# from a POT file.
+#
