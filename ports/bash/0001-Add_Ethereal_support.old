diff -Naur old_extract/bash-5.2/externs.h new_workspace/bash-5.2/externs.h
--- a/externs.h	2022-07-05 10:08:50.000000000 -0500
+++ b/externs.h	2026-06-27 12:52:12.017543811 -0500
