diff -Naur old_extract/bash-5.2/support/shobj-conf new_workspace/bash-5.2/support/shobj-conf
--- a/support/shobj-conf	2021-12-03 09:54:46.000000000 -0600
+++ b/support/shobj-conf	2026-06-27 12:52:28.953784799 -0500
@@ -79,6 +79,10 @@
 	SHOBJ_LDFLAGS='-shared -bglobalized -unres_symbols ignore'
 	;;
 
+ethereal*-*gcc*)
+	SHOBJ_CFLAGS=-fpic
+	;;
+
 sunos4*-*gcc*)
 	SHOBJ_CFLAGS=-fpic
 	SHOBJ_LD=/usr/bin/ld
