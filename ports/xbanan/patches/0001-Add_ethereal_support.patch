+static inline void ethereal_set_keymap(uint8_t scancode, uint32_t normal, uint32_t shifted = 0) {
+    g_keymap[scancode][0] = normal;
+    g_keymap[scancode][1] = shifted ? shifted : normal;
+}
+
+static void ethereal_initialize_keymap() {
+    memset(g_keymap, 0, sizeof(g_keymap));
+    memset(g_modifier_map, 0, sizeof(g_modifier_map));
+
+    for (const auto& entry : keymap)
+        ethereal_set_keymap(entry.scancode, entry.normal, entry.shifted);
+
+    g_modifier_map[0][0] = 0x2a + g_keymap_min_keycode;
+    g_modifier_map[0][1] = 0x36 + g_keymap_min_keycode;
+    g_modifier_map[1][0] = 0x3a + g_keymap_min_keycode;
+    g_modifier_map[2][0] = 0x1d + g_keymap_min_keycode;
+    g_modifier_map[2][1] = EXTENDED(0x1d) + g_keymap_min_keycode;
+    g_modifier_map[3][0] = 0x38 + g_keymap_min_keycode;
+    g_modifier_map[3][1] = EXTENDED(0x38) + g_keymap_min_keycode;
+    g_modifier_map[4][0] = 0x45 + g_keymap_min_keycode;
+    g_modifier_map[6][0] = EXTENDED(0x5b) + g_keymap_min_keycode;
+    g_modifier_map[6][1] = EXTENDED(0x5c) + g_keymap_min_keycode;
+    g_modifier_map[7][0] = EXTENDED(0x38) + g_keymap_min_keycode;
+}
+
+struct EtherealWindow final : public PlatformWindow {
+    ~EtherealWindow()
+    {
+        if (!window)
+            return;
+
+        window->d = nullptr;
+        if (window->state != CELESTIAL_STATE_CLOSED)
+            celestial_closeWindow(window);
+    }
+
+    window_t *window { nullptr };
+    WINDOW wid;
+    uint32_t width;
+    uint32_t height;
+};
+
+
+static bool ethereal_initialize(uint32_t *display_w, uint32_t *display_h) {
+    celestial_info_t *info =celestial_getServerInformation();
+    if (!info) {
+        fprintf(stderr, "ethereal_initialize: failed to get Celestial server information: %s\n", strerror(errno));
+        return false;
+    }
+
+    *display_w = info->screen_width;
+    *display_h = info->screen_height; 
+
+    keyboard = keyboard_create();
+    if (!keyboard) {
+        fprintf(stderr, "ethereal_initialize: failed to create keyboard state\n");
+        return false;
+    }
+
+    ethereal_initialize_keymap();
+    return true;
+}
+
+static void ethereal_mouse_handler(window_t *window, uint32_t event_type, void *event) {
+    if (!window->d)
+        return;
+    auto& ewindow = *static_cast<EtherealWindow*>(window->d);
+    if (event_type == CELESTIAL_EVENT_MOUSE_MOTION) {
+        celestial_event_mouse_motion_t *ev = (celestial_event_mouse_motion_t*)event;
+        on_mouse_move_event(ewindow.wid, ev->x, ev->y);;
+    } else if (event_type == CELESTIAL_EVENT_MOUSE_DRAG) {
+	celestial_event_mouse_drag_t *ev = (celestial_event_mouse_drag_t*)event;
+	on_mouse_move_event(ewindow.wid, ev->x, ev->y);
+    } else if (event_type == CELESTIAL_EVENT_MOUSE_BUTTON_DOWN) {
+        celestial_event_mouse_button_down_t *ev = (celestial_event_mouse_button_down_t *)event;
+        
+        uint8_t xbutton { 0 };
+        switch (ev->held) {
+            case CELESTIAL_MOUSE_BUTTON_LEFT: xbutton = 1; break;
+            case CELESTIAL_MOUSE_BUTTON_MIDDLE: xbutton = 2; break;
+            case CELESTIAL_MOUSE_BUTTON_RIGHT: xbutton = 3; break;
+            default: return;
+        }
+
+        on_mouse_button_event(ewindow.wid, xbutton, true);
+    } else if (event_type == CELESTIAL_EVENT_MOUSE_BUTTON_UP) {
+        celestial_event_mouse_button_up_t *ev = (celestial_event_mouse_button_up_t *)event;
+        
+        uint8_t xbutton { 0 };
+        switch (ev->released) {
+            case CELESTIAL_MOUSE_BUTTON_LEFT: xbutton = 1; break;
+            case CELESTIAL_MOUSE_BUTTON_MIDDLE: xbutton = 2; break;
+            case CELESTIAL_MOUSE_BUTTON_RIGHT: xbutton = 3; break;
+            default: return;
+        }
+
+        on_mouse_button_event(ewindow.wid, xbutton, false);
+    } else if (event_type == CELESTIAL_EVENT_MOUSE_EXIT) {
+        on_window_leave_event(ewindow.wid);
+    }
+}
+
+static void ethereal_window_handler(window_t *window, uint32_t event_type, void *event) {
+    if (!window->d) return;
+    auto& ewindow = *static_cast<EtherealWindow*>(window->d);
+    if (event_type == CELESTIAL_EVENT_FOCUSED) {
+        on_window_focus_event(ewindow.wid, true);
+    } else if (event_type == CELESTIAL_EVENT_UNFOCUSED) {
+        on_window_focus_event(ewindow.wid, false);
+    } else if (event_type == CELESTIAL_EVENT_WINDOW_CLOSE) {
+        on_window_close_event(ewindow.wid);
+    } else if (event_type == CELESTIAL_EVENT_RESIZE) {
+        auto *resize = static_cast<celestial_event_resize_t*>(event);
+        ewindow.width = resize->new_width;
+        ewindow.height = resize->new_height;
+        on_window_resize_event(ewindow.wid, resize->new_width, resize->new_height);
+    } else if (event_type == CELESTIAL_EVENT_POSITION_CHANGE) {
+        auto *change = static_cast<celestial_event_position_change_t*>(event);
+        on_window_move_event(ewindow.wid, change->x, change->y);
+    }
+}
+
+static void ethereal_key_handler(window_t *window, uint32_t event_type, void *event) {
+    if (!window->d || event_type != CELESTIAL_EVENT_KEY_EVENT) return;
+
+    auto& ewindow = *static_cast<EtherealWindow*>(window->d);
+    auto* key = static_cast<celestial_event_key_t*>(event);
+    const key_event_t raw = key->ev;
+    keyboard_event_t translated;
+    keyboard_event2(keyboard, &key->ev, &translated);
+
+    if (raw.scancode == 0xe0) {
+        is_extended_scancode = true;
+        return;
+    }
+
+    uint8_t scancode = raw.scancode;
+    if (scancode >= 0x80) scancode -= 0x80;
+    if (is_extended_scancode) {
+        scancode = EXTENDED(scancode);
+        is_extended_scancode = false;
+    }
+
+    uint8_t xmod =
+        ((translated.mods & (KEYBOARD_MOD_LEFT_SHIFT | KEYBOARD_MOD_RIGHT_SHIFT)) ? (1 << 0) : 0) |
+        ((translated.mods & (KEYBOARD_MOD_LEFT_CTRL  | KEYBOARD_MOD_RIGHT_CTRL))  ? (1 << 2) : 0) |
+        ((translated.mods & (KEYBOARD_MOD_LEFT_ALT   | KEYBOARD_MOD_RIGHT_ALT))   ? (1 << 3) : 0) |
+        ((translated.mods & (KEYBOARD_MOD_LEFT_SUPER | KEYBOARD_MOD_RIGHT_SUPER)) ? (1 << 6) : 0) |
+        ((translated.mods & KEYBOARD_MOD_RIGHT_ALT) ? (1 << 7) : 0);
+
+    on_key_event(ewindow.wid, scancode, xmod, translated.type == KEYBOARD_EVENT_PRESS);
+}
+
+static BAN::ErrorOr<BAN::UniqPtr<PlatformWindow>> ethereal_create_window(PlatformWindow* parent, WindowType type, WINDOW wid, int32_t x, int32_t y, uint32_t width, uint32_t height) {
+    (void)parent;
+
+    auto window = TRY(BAN::UniqPtr<EtherealWindow>::create());
+
+    wid_t cwid = type == WindowType::Popup
+        ? celestial_createWindowUndecorated(CELESTIAL_WINDOW_FLAG_SOLID, width, height)
+        : celestial_createWindow(0, width, height);
+    if (cwid < 0) {
+        fprintf(stderr, "ethereal_create_window: celestial_createWindow: %s\n", strerror(errno));
+        return BAN::Error::from_errno(errno);
+    }
+    
+    window_t *win = celestial_getWindow(cwid);
+    if (!win) {
+        fprintf(stderr, "ethereal_create_window: celestial_getWindow: %s\n", strerror(errno));
+        return BAN::Error::from_errno(errno);
+    }
+
+    if (celestial_setWindowPosition(win, x, y) < 0) {
+        fprintf(stderr, "ethereal_create_window: celestial_setWindowPosition: %s\n", strerror(errno));
+        celestial_closeWindow(win);
+        return BAN::Error::from_errno(errno);
+    }
+
+    window->window = win;
+    window->wid = wid;
+    window->width = width;
+    window->height = height;
+    win->d = window.ptr();
+
+    // Setup event handlers
+    celestial_setHandler(win, CELESTIAL_EVENT_MOUSE_MOTION, ethereal_mouse_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_MOUSE_BUTTON_DOWN, ethereal_mouse_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_MOUSE_BUTTON_UP, ethereal_mouse_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_MOUSE_EXIT,  ethereal_mouse_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_FOCUSED,  ethereal_window_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_UNFOCUSED,  ethereal_window_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_WINDOW_CLOSE, ethereal_window_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_POSITION_CHANGE, ethereal_window_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_RESIZE, ethereal_window_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_KEY_EVENT, ethereal_key_handler);
+    celestial_setHandler(win, CELESTIAL_EVENT_MOUSE_DRAG, ethereal_mouse_handler);
+
+    // celestial is connected now
+    if (!has_registered) {
+        register_event_fd(celestial_getSocketFile(), nullptr);   
+        has_registered = true;
+    }
+
+    return BAN::UniqPtr<PlatformWindow>(BAN::move(window));
+}
+
+static void ethereal_invalidate(PlatformWindow* pwindow, const uint32_t* pixels, uint32_t x, uint32_t y, uint32_t width, uint32_t height) {
+    auto &window = *static_cast<EtherealWindow*>(pwindow);
+    window_t *cwindow = (window.window);    
+    gfx_context_t *ctx = celestial_getGraphicsContext(cwindow);
+    uint32_t *framebuffer = (uint32_t*)ctx->backbuffer;
+
+    if (x >= cwindow->width || y >= cwindow->height) {
+        return;
+    }
+
+    if (width > cwindow->width - x) width = cwindow->width - x;
+    if (height > cwindow->height - y) height = cwindow->height - y;
+    
+    for (uint32_t y_off = 0; y_off < height; y_off++) {
+        for (uint32_t x_off = 0; x_off < width; x_off++) {
+            framebuffer[(y + y_off) * (ctx->pitch/4) + (x + x_off)] = pixels[(y + y_off) * window.width + (x + x_off)] | 0xff000000;
+        }
+    }
+
+    gfx_render(ctx);
+    celestial_flip(cwindow);
+}
+
+static void ethereal_poll_events(void *window) {
+    celestial_poll();
+}
+
+static void ethereal_query_pointer(int32_t *x, int32_t *y){
+    int mx, my;
+    celestial_queryMouse(&mx, &my);
+    *x = mx;
+    *y = my;
+}
+
+static void ethereal_request_reposition(PlatformWindow *pwindow, int32_t x, int32_t y) {
+    auto &window = *static_cast<EtherealWindow*>(pwindow);
+    window_t *cwindow = (window.window);
+    celestial_setWindowPosition(cwindow, x, y);
+}
+
+static void ethereal_request_resize(PlatformWindow *pwindow, uint32_t width, uint32_t height) {
+    auto &window = *static_cast<EtherealWindow*>(pwindow);
+    celestial_resizeWindow(window.window, width, height);
+}
