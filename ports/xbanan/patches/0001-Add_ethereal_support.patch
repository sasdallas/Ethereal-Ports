+    .create_window      = ethereal_create_window,
+    .invalidate         = ethereal_invalidate,
+    .request_resize     = ethereal_request_resize,
+    .request_reposition = ethereal_request_reposition,
+    .request_fullscreen = nullptr,
+    .warp_pointer       = nullptr,
+    .query_pointer      = ethereal_query_pointer,
+    .set_pointer_grab   = nullptr,
+    .create_system_cursor   = nullptr,
+    .set_cursor         = nullptr,
+};
